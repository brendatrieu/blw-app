PORT=3000
# NODE_ENV is deliberately left unset here: config.ts already defaults it to
# "development", so local runs need no line at all — while a copy of this file
# used as a production env_file could otherwise silently flip a real
# deployment into development mode (weaker auth defaults, the loopback auth
# bypass, insecure fallback secrets). Set NODE_ENV=production explicitly in
# production; the Docker image already does.
# NODE_ENV=development
# DATABASE_URL=postgres://user:pass@localhost:5432/blw
# Omit DATABASE_URL to use the local PGlite dev database (server/.data/pglite).

# --- Auth -------------------------------------------------------------------
# Signing secret for session cookies. Required in production; development
# falls back to a fixed insecure value. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=
# Public origin the app is served from. Used to build links in emails and as
# the default trusted origin.
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins allowed to send credentialed requests. The
# Vite dev server (http://localhost:5173) is trusted automatically outside
# production.
# TRUSTED_ORIGINS=

# --- Local development convenience ------------------------------------------
# Dev-only auto-authentication. When NODE_ENV=development, a request that
# arrives on the loopback interface (127.0.0.1 / ::1) with no valid session is
# served as a fixed local user, dev-bypass@localhost.local, created on
# first use. Signing out in development simply lands you back as that user.
#
# That user's password is a random per-machine secret generated on first use
# and kept in the gitignored server/.data/dev-auth-secret (mode 0600) — never
# a value committed to this repository. Delete that file and the dev user is
# re-provisioned from scratch on the next request, resetting its dev-only data.
#
# On by default in development; set to 0 to require a real sign-in locally.
# It is inert everywhere else by construction: the hook is not installed
# unless NODE_ENV is exactly "development" (so NODE_ENV=test and
# NODE_ENV=production — which the Docker image sets — keep real auth), and the
# loopback check reads the raw socket address, never X-Forwarded-For.
# DEV_AUTO_AUTH=0

# --- Google sign-in (optional) ----------------------------------------------
# Both must be set together, or the server refuses to start. When unset, the
# "Continue with Google" button is disabled in the UI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Transactional email (optional) -----------------------------------------
# Without an API key, verification and password-reset links are written to the
# server log instead of being emailed (development only).
# RESEND_API_KEY=
# EMAIL_FROM=Baby-Led Weaning <onboarding@resend.dev>

# --- AI (bring your own Anthropic key) --------------------------------------
# Master secret each user's Anthropic API key is encrypted with (AES-256-GCM).
# Required in production, minimum 32 characters; development falls back to a
# fixed insecure value. Rotating it makes every stored key undecryptable —
# users would have to re-enter theirs. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# KEY_ENCRYPTION_SECRET=

# --- Rate limiting ----------------------------------------------------------
# Requests per minute per IP: the first applies to /api/auth/*, the second to
# everything else.
# AUTH_RATE_LIMIT_MAX=10
# GLOBAL_RATE_LIMIT_MAX=300
# Requests per hour per signed-in user: the first covers /api/ai/*, the second
# covers saving an AI key (each save spends a live Anthropic API call).
# AI_RATE_LIMIT_MAX=20
# AI_KEY_RATE_LIMIT_MAX=5
